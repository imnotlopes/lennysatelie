# ============================================================================
# Lennys Ateliê — variáveis de ambiente
#
# Copie este arquivo para .env.local e preencha com os dados do seu projeto.
# O .env.local não vai para o Git.
#
# Onde achar: painel do Supabase > Project Settings > API
# ============================================================================

# URL do projeto. Formato: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima (anon / public). Pode aparecer no browser: é ela que a RLS
# protege. Nunca coloque a service_role aqui.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Endereço público do site, sem barra no fim. Usado no canonical, no sitemap
# e no link de cupom que o painel monta.
#
# No primeiro deploy, antes de o domínio existir, ponha o endereço da Vercel:
#   NEXT_PUBLIC_SITE_URL=https://lennysatelie.vercel.app
#
# Vazio aqui significa usar https://lennysatelie.com.br, que é o definitivo.
NEXT_PUBLIC_SITE_URL=

# ----------------------------------------------------------------------------
# Só para carga de fotos pela linha de comando. NÃO é usada pelo site.
#
# A chave service_role passa por cima da RLS. É por isso que ela resolve o
# envio em massa de fotos sem precisar abrir o bucket para escrita anônima.
#
# Nunca use o prefixo NEXT_PUBLIC_ aqui: isso mandaria a chave para o browser
# e daria a qualquer visitante acesso total ao banco. Não configure essa
# variável na Vercel — ela vive só no .env.local da sua máquina.
#
# Onde achar: painel do Supabase > Project Settings > API Keys > service_role
# SUPABASE_SERVICE_ROLE_KEY=
